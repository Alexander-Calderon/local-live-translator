# Solo fuentes, documentación y ejemplos públicos. El resto queda local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE.md
!/run.sh
!/app.sh
!/install.sh
!/requirements.txt
!/bin/
!/docs/
!/tests/
!/vocab/
!/.github/

**/__pycache__/
*.py[cod]
*.bak
*.log
*.env
.env*
*.pem
*.key
*.sqlite*
*.db
*.wav
*.mp3
*.mp4
*.onnx
*.bin
*.cact
*.resumen.md
*.session*
*.history*
/vocab/*
!/vocab/tech-example.txt
!/vocab/tech-aliases.json
/bin/resumir.sh

!/CONTRIBUTING.md
!/SECURITY.md
!/CHANGELOG.md
!/VERSION
/docs/media-private/
